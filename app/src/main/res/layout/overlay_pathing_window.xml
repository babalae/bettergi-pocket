<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_panel"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="地图追踪"
            android:textColor="@color/overlay_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/pathing_window_close"
            style="@style/PathingWindowAction"
            android:text="关闭" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/pathing_tab_routes"
            style="@style/PathingWindowAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="路线选择" />
        <TextView
            android:id="@+id/pathing_tab_settings"
            style="@style/PathingWindowAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="设置" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pathing_routes_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/pathing_browser_up"
                style="@style/PathingWindowAction"
                android:text="上一级" />
            <TextView
                android:id="@+id/pathing_browser_directory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="start"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:text="全部路线"
                android:textColor="@color/overlay_text_muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/pathing_select_visible"
                style="@style/PathingWindowAction"
                android:text="选中本页" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_overlay_row"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/pathing_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="start|center_vertical"
                android:hint="搜索目录或路线"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/overlay_text"
                android:textColorHint="@color/overlay_text_muted"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/pathing_search_clear"
                style="@style/PathingWindowAction"
                android:text="清空" />
        </LinearLayout>

        <TextView
            android:id="@+id/pathing_browser_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="点击目录进入，勾选目录可执行全部子目录路线"
            android:textColor="@color/overlay_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/pathing_browser_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="正在读取路线…"
            android:textColor="@color/overlay_text_muted"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pathing_browser_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/pathing_settings_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="执行设置"
                android:textColor="@color/overlay_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/pathing_setting_map_matching"
                style="@style/PathingWindowAction"
                android:layout_width="match_parent"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="默认地图匹配方式：模板匹配" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="点击切换：模板匹配 / SIFT。路线未指定匹配方式时使用此设置；路线指定的方式优先。坐标显示也使用此设置。"
                android:textColor="@color/overlay_text_muted"
                android:textSize="12sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/pathing_setting_gadget_enabled"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="自动使用小道具"
                android:textColor="@color/overlay_text"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/pathing_setting_gadget_interval"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="使用间隔（秒）"
                    android:textColor="@color/overlay_text"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/pathing_setting_gadget_interval"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="例如 0.5"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@color/overlay_text"
                    android:textColorHint="@color/overlay_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="点击输入框使用数字键盘，支持小数（最多 3 位）。输入后自动保存；关闭开关会保留间隔。"
                android:textColor="@color/overlay_text_muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/pathing_setting_main_avatar"
                style="@style/PathingMultiSelect"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="行走位 ▾" />
            <TextView
                android:id="@+id/pathing_setting_guardian_avatar"
                style="@style/PathingMultiSelect"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="生存位 · 循环短战技 ▾" />
            <TextView
                android:id="@+id/pathing_setting_guardian_press"
                style="@style/PathingMultiSelect"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="生存位 · 循环长战技 ▾" />
            <TextView
                android:id="@+id/pathing_setting_guardian_interval"
                style="@style/PathingWindowAction"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="续盾间隔：使用角色冷却" />
            <TextView
                android:id="@+id/pathing_setting_element_hydro"
                style="@style/PathingMultiSelect"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="水元素采集：自动" />
            <TextView
                android:id="@+id/pathing_setting_element_electro"
                style="@style/PathingMultiSelect"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="雷元素采集：自动" />
            <TextView
                android:id="@+id/pathing_setting_element_anemo"
                style="@style/PathingMultiSelect"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="风元素采集：自动" />
            <TextView
                android:id="@+id/pathing_setting_element_pyro"
                style="@style/PathingMultiSelect"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="火元素采集：自动" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="点击 ▾ 展开多选：支持搜索、勾选多个角色、调整优先级和恢复默认。执行时按已选顺序匹配当前队伍，未在队的候选自动跳过。生存位先匹配短战技组，再匹配长战技组。清空某项即关闭；元素采集仅在路线指定元素动作时执行。"
                android:textColor="@color/overlay_text_muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/pathing_setting_readout"
                style="@style/PathingWindowAction"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overlay_row"
                android:gravity="start|center_vertical"
                android:text="显示坐标" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="坐标显示可独立开启；执行路线前会自动停止坐标显示。\n\n按目录顺序执行，每个文件只执行一次。遇到不支持的动作会记录日志并跳过该路线，继续执行下一条。"
                android:textColor="@color/overlay_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/pathing_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已选 0 条路线"
            android:textColor="@color/overlay_text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/pathing_selection_clear"
            style="@style/PathingWindowAction"
            android:text="清除选择" />
        <TextView
            android:id="@+id/pathing_execute"
            style="@style/PathingWindowAction"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_overlay_launch"
            android:text="执行路线" />
    </LinearLayout>
</LinearLayout>
