<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/overlay_root" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <FrameLayout android:id="@+id/overlay_bubble" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="更好的原神悬浮球">
        <View android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center" android:background="@drawable/bg_overlay_bubble_shadow" android:translationY="2dp"/>
        <ImageView android:id="@+id/overlay_bubble_icon" android:layout_width="49dp" android:layout_height="49dp" android:layout_gravity="center" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/ic_overlay_bubble"/>
        <View android:id="@+id/overlay_status_dot" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="end|bottom" android:layout_marginEnd="2dp" android:layout_marginBottom="2dp" android:background="@drawable/bg_overlay_status_dot"/>
        <ImageView android:id="@+id/overlay_chat_badge" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="end|top" android:layout_marginTop="1dp" android:layout_marginEnd="1dp" android:background="@drawable/bg_overlay_chat_badge" android:contentDescription="正在对话" android:padding="3dp" android:src="@drawable/ic_overlay_chat" android:visibility="gone"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/overlay_panel" android:layout_width="256dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_pocket_window" android:visibility="gone">
        <LinearLayout android:id="@+id/overlay_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_overlay_bubble" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView style="@style/Pocket.Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="更好的原神"/>
                <TextView android:id="@+id/overlay_status_text" style="@style/Pocket.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未共享" android:background="@drawable/bg_pocket_chip" android:paddingHorizontal="6dp"/>
            </LinearLayout>
            <ImageButton style="@style/Pocket.IconButton" android:id="@+id/overlay_log_toggle" android:src="@drawable/ic_ui_article" android:contentDescription="显示或隐藏状态条" app:tint="@color/pocket_text_secondary"/>
            <ImageButton style="@style/Pocket.IconButton" android:id="@+id/overlay_collapse" android:src="@drawable/ic_ui_close" android:contentDescription="收起面板" app:tint="@color/pocket_text_secondary"/>
        </LinearLayout>
        <ScrollView android:id="@+id/overlay_panel_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/overlay_warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_pocket_warning" android:visibility="gone">
                    <TextView android:id="@+id/overlay_warning_text" style="@style/Pocket.Text.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/pocket_warning"/>
                    <TextView android:id="@+id/overlay_warning_action" style="@style/Pocket.Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="28dp" android:gravity="center" android:paddingHorizontal="6dp" android:text="去开启" android:background="@drawable/bg_pocket_chip" android:textColor="@color/pocket_primary"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:background="@drawable/bg_pocket_group">
                    <LinearLayout android:id="@+id/overlay_row_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_ui_screen_share" app:tint="@color/pocket_text_secondary" android:importantForAccessibility="no"/>
                        <TextView style="@style/Pocket.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="共享屏幕"/>
                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/overlay_switch_enabled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="切换功能" app:thumbTint="@color/overlay_switch_thumb" app:trackTint="@color/overlay_switch_track"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="44dp" android:background="@color/pocket_divider"/>
                    <LinearLayout android:id="@+id/overlay_row_auto_skip" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_ui_forum" app:tint="@color/pocket_text_secondary" android:importantForAccessibility="no"/>
                        <TextView style="@style/Pocket.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="自动对话"/>
                        <TextView android:id="@+id/overlay_quick_skip_chip" style="@style/Pocket.Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="28dp" android:gravity="center" android:paddingHorizontal="6dp" android:text="快跳" android:background="@drawable/bg_pocket_chip" android:textColor="@color/pocket_primary"/>
                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/overlay_switch_auto_skip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="切换功能" app:thumbTint="@color/overlay_switch_thumb" app:trackTint="@color/overlay_switch_track"/>
                    </LinearLayout>
                    <TextView android:id="@+id/overlay_auto_skip_hint" style="@style/Pocket.Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="44dp" android:paddingBottom="4dp" android:visibility="gone" android:textColor="@color/pocket_warning"/>
                    <LinearLayout android:id="@+id/overlay_row_auto_pick" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:visibility="gone">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_ui_add" app:tint="@color/pocket_text_secondary" android:importantForAccessibility="no"/>
                        <TextView style="@style/Pocket.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="自动拾取"/>
                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/overlay_switch_auto_pick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="切换功能" app:thumbTint="@color/overlay_switch_thumb" app:trackTint="@color/overlay_switch_track"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/overlay_group_pathing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/bg_pocket_group">
                    <LinearLayout android:id="@+id/overlay_row_pathing" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_ui_map" app:tint="@color/pocket_text_secondary" android:importantForAccessibility="no"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Pocket.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="地图追踪"/>
                            <TextView android:id="@+id/overlay_pathing_status" style="@style/Pocket.Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="未选择路线" android:maxLines="1" android:ellipsize="end"/>
                            <ProgressBar android:id="@+id/overlay_pathing_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp" android:progressTint="@color/pocket_primary" android:visibility="gone"/>
                        </LinearLayout>
                        <ImageButton style="@style/Pocket.IconButton" android:id="@+id/overlay_pathing_start" android:src="@drawable/ic_ui_play_arrow" android:contentDescription="执行上次选择的路线" app:tint="@color/pocket_text_secondary"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/bg_pocket_group">
                    <LinearLayout android:id="@+id/overlay_row_launch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_ui_open_in_new" app:tint="@color/pocket_text_secondary" android:importantForAccessibility="no"/>
                        <TextView style="@style/Pocket.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="启动原神"/>
                        <TextView android:id="@+id/overlay_auto_launch_chip" style="@style/Pocket.Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="28dp" android:gravity="center" android:paddingHorizontal="4dp" android:text="自动" android:background="@drawable/bg_pocket_chip" android:textColor="@color/pocket_primary"/>
                        <TextView android:id="@+id/overlay_launch" style="@style/Pocket.Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="28dp" android:gravity="center" android:paddingHorizontal="8dp" android:text="启动" android:background="@drawable/bg_pocket_chip" android:textColor="@color/pocket_primary"/>
                    </LinearLayout>
                    <TextView android:id="@+id/overlay_launch_subtitle" style="@style/Pocket.Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="44dp" android:paddingBottom="4dp" android:visibility="gone" android:textColor="@color/pocket_warning"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:id="@+id/overlay_bilibili" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="B站主页" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_overlay_bilibili" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
                    </FrameLayout>
                    <TextView style="@style/Pocket.Text.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="v1.0"/>
                    <ImageButton style="@style/Pocket.IconButton" android:id="@+id/overlay_exit" android:src="@drawable/ic_ui_power_settings_new" android:contentDescription="退出助手" app:tint="@color/pocket_text_secondary"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
