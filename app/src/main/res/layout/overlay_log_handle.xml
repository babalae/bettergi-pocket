<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_log_handle"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/overlay_log_drag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="☰"
            android:textColor="@color/overlay_log_green"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/overlay_log_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="识别日志"
            android:textColor="@color/overlay_log_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/overlay_log_close"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_overlay_close"
        android:contentDescription="关闭识别日志"
        android:padding="4dp"
        android:src="@drawable/ic_overlay_close"
        app:tint="@color/overlay_log_green" />
</LinearLayout>
