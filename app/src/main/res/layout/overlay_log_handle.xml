<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:background="@drawable/bg_overlay_log_handle" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp">
    <LinearLayout android:id="@+id/overlay_log_drag" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="28dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/overlay_log_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_ui_article" app:tint="@color/pocket_primary" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/overlay_log_title" style="@style/Pocket.Text.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:maxLines="1" android:ellipsize="end" android:text="等待识别"/>
    </LinearLayout>
    <TextView android:id="@+id/overlay_log_elapsed" style="@style/Pocket.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:visibility="gone"/>
    <ImageButton style="@style/Pocket.IconButton" android:id="@+id/overlay_log_stop" android:src="@drawable/ic_ui_stop" android:contentDescription="停止地图追踪" app:tint="@color/pocket_error"/>
    <ImageButton style="@style/Pocket.IconButton" android:id="@+id/overlay_log_expand" android:src="@drawable/ic_ui_expand_more" android:contentDescription="展开或收起日志" app:tint="@color/pocket_text_secondary"/>
    <ImageButton style="@style/Pocket.IconButton" android:id="@+id/overlay_log_close" android:src="@drawable/ic_ui_close" android:contentDescription="隐藏状态条" app:tint="@color/pocket_text_secondary"/>
</LinearLayout>
